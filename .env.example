# Copy to .env and fill in real values. Never commit .env.

# Local ingestion / embedding
EMBED_MODEL=BAAI/bge-small-en-v1.5
LANCE_PATH=./data/lance
DB_PATH=...

# Ollama (local LLM for curio ask CLI)
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434/api/chat

# Hugging Face (model downloads, only needed for gated models)
HF_TOKEN=hf_replace_me

# Gemini (web demo LLM)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Cloud (shared vector DB)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace_me
QDRANT_COLLECTION=chunks
